<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage1.master.cs" Inherits="IttaiWebDemo.MasterPage1" ClientIDMode="Static" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Dancing</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="StyleSheet1.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <div class="top_container">
              <div class="box side"><img src="/images/dancing_logo.jpg" alt="Dancing"></div>
              <div class="box middle">ריקודי עם ישראלים</div>
              <div class="box side"><%= "Welcome " + Session["UserName"] %></div>
            </div>
        </div>
        <nav>
            <ul>
                <li id="menuMain" runat="server"><a href="Main.aspx">Main</a></li>
                <li id="nemuLogin" runat="server"><a href="Login.aspx">Login</a></li>
                <li id="menuRegister" runat="server"><a href="Registration.aspx">Registration</a></li>
                <li id="menuAbout" runat="server"><a href="About.aspx">About</a></li>
                <li id="menuHistory" runat="server"><a href="History.aspx">History</a></li>
                <li id="menuCircle" runat="server"><a href="Circle.aspx">ריקודי מעגל</a></li>
                <li id="menuLines" runat="server"><a href="Lines.aspx">ריקודי שורות</a></li>
                <li id="menuCouples" runat="server"><a href="Couples.aspx">ריקודי זוגות</a></li>
            </ul>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
